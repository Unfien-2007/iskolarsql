<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.iskolar.controller.AdminDashboardController">
    <!-- Dashboard -->
    <VBox fx:id="contentBox" spacing="10" styleClass="admin-root">
        <Label text="Admin Portal" styleClass="view-title"/>
        <Label text="Manage the scholarship catalog and the accounts that can access this portal."
               styleClass="view-subtitle" wrapText="true"/>
        <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <Tab text="Scholarships">
                <VBox spacing="10">
                    <HBox spacing="8">
                        <Button fx:id="newButton" text="New Scholarship" styleClass="primary-button"/>
                        <Button fx:id="editButton" text="Edit" disable="true"/>
                        <Button fx:id="toggleButton" text="Deactivate" disable="true"/>
                        <Button fx:id="deleteButton" text="Delete" disable="true" styleClass="danger-button"/>
                    </HBox>
                    <TableView fx:id="table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="titleCol" text="Title" prefWidth="360"/>
                            <TableColumn fx:id="providerCol" text="Provider" prefWidth="220"/>
                            <TableColumn fx:id="typeCol" text="Type" prefWidth="170"/>
                            <TableColumn fx:id="deadlineCol" text="Deadline" prefWidth="110"/>
                            <TableColumn fx:id="statusCol" text="Status" prefWidth="90"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            <Tab text="Users">
                <VBox spacing="10">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button fx:id="refreshUsersButton" text="Refresh"/>
                        <Button fx:id="roleUserButton" text="Make admin" disable="true"/>
                        <Button fx:id="disableUserButton" text="Disable" disable="true"
                                styleClass="danger-button"/>
                        <Label fx:id="usersStatusLabel" styleClass="sync-label"/>
                    </HBox>
                    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="userEmailCol" text="Email" prefWidth="320"/>
                            <TableColumn fx:id="userRoleCol" text="Role" prefWidth="110"/>
                            <TableColumn fx:id="userStatusCol" text="Status" prefWidth="110"/>
                            <TableColumn fx:id="userCreatedCol" text="Created" prefWidth="130"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </VBox>

    <!-- Access gate -->
    <VBox fx:id="gatePane" alignment="CENTER" spacing="12" maxWidth="420" styleClass="auth-card">
        <Label text="Admin access only" styleClass="view-title"/>
        <Label fx:id="gateLabel" text="This area is restricted to administrator accounts."
               styleClass="view-subtitle" wrapText="true" textAlignment="CENTER"/>
        <Button fx:id="gateButton" text="Log in" styleClass="primary-button"/>
    </VBox>
</StackPane>
