<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.iskolar.controller.TrackerController">
    <center>
        <StackPane>
            <!-- Board -->
            <VBox fx:id="boardPane" spacing="10">
                <VBox spacing="6" styleClass="discovery-header">
                    <Label text="My Application Tracker" styleClass="view-title"/>
                    <Label text="Track each application from saved to awarded."
                           styleClass="view-subtitle" wrapText="true"/>
                </VBox>
                <!-- fitToWidth lets the columns share the visible board width; when the
                     window is narrower than the columns' total min width the pane
                     falls back to horizontal scrolling. -->
                <ScrollPane fx:id="boardScroll" fitToWidth="true" fitToHeight="true"
                            hbarPolicy="AS_NEEDED" styleClass="kanban-scroll">
                    <HBox fx:id="boardRow" styleClass="kanban-row"/>
                </ScrollPane>

                <!-- One explanation beats six empty columns when nothing is tracked.
                     The pane spans the board width and centres its own content. -->
                <VBox fx:id="emptyPane" alignment="CENTER" spacing="10" maxWidth="Infinity"
                      styleClass="empty-state" visible="false" VBox.vgrow="ALWAYS">
                    <Label text="No applications yet" styleClass="empty-state-title"/>
                    <Label text="Save a scholarship from Discover and it will show up here, ready to track."
                           styleClass="empty-state-text" wrapText="true" maxWidth="420"
                           textAlignment="CENTER"/>
                    <Button fx:id="emptyBrowseButton" text="Browse scholarships"
                            styleClass="primary-button"/>
                </VBox>
            </VBox>

            <!-- Gate: no session or no profile -->
            <VBox fx:id="gatePane" alignment="CENTER" spacing="12" maxWidth="420" maxHeight="-Infinity"
                  styleClass="auth-card">
                <Label text="Application Tracker" styleClass="view-title"/>
                <Label fx:id="gateLabel" text="Log in to track your scholarship applications."
                       styleClass="view-subtitle" wrapText="true" textAlignment="CENTER"/>
                <Button fx:id="gateButton" text="Log in" styleClass="primary-button"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
