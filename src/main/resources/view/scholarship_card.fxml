<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Discovery-grid scholarship card; data injected by ScholarshipCardController. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.iskolar.controller.ScholarshipCardController"
            styleClass="scholarship-card" prefWidth="340" minHeight="210" maxHeight="210">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label fx:id="providerBadge" styleClass="badge"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="urgencyPill" styleClass="pill"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="6">
            <Label fx:id="titleLabel" styleClass="card-title" wrapText="true"
                   maxWidth="Infinity" maxHeight="46"/>
            <Label fx:id="providerLabel" styleClass="card-provider" wrapText="true" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <HBox spacing="14">
                <Label fx:id="tuitionLabel" styleClass="card-highlight"/>
                <Label fx:id="stipendLabel" styleClass="card-highlight"/>
            </HBox>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button fx:id="saveButton" text="Save" styleClass="ghost-button"/>
            <CheckBox fx:id="compareCheck" text="Compare" styleClass="compare-check"/>
            <Label fx:id="matchCaption" styleClass="match-caption"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="matchBadge" styleClass="match-badge"/>
        </HBox>
    </bottom>
</BorderPane>
