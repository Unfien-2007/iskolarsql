<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Discovery-grid scholarship card; data injected by ScholarshipCardController.
     Mirrors the reference: dotted provider pill + urgency pill, title, provider,
     closing date, a two-column TUITION/STIPEND block, then Save / compare. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.iskolar.controller.ScholarshipCardController"
            styleClass="scholarship-card" prefWidth="320" minHeight="230" maxHeight="230">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <HBox fx:id="providerBadge" alignment="CENTER_LEFT" spacing="6" styleClass="badge">
                <Region fx:id="providerDot" styleClass="badge-dot"/>
                <Label fx:id="providerBadgeText" minWidth="0" maxWidth="190" textOverrun="ELLIPSIS"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="urgencyPill" styleClass="pill"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="4">
            <Label fx:id="titleLabel" styleClass="card-title" wrapText="true"
                   alignment="TOP_LEFT" maxWidth="Infinity" maxHeight="50"/>
            <Label fx:id="providerLabel" styleClass="card-provider"
                   minWidth="0" textOverrun="ELLIPSIS" maxHeight="20" maxWidth="Infinity"/>
            <Label fx:id="closesLabel" styleClass="card-closes" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <HBox spacing="18" fillHeight="true">
                <VBox spacing="2" HBox.hgrow="ALWAYS" minWidth="0" prefWidth="0">
                    <Label text="TUITION" styleClass="card-field-label"/>
                    <Label fx:id="tuitionValue" styleClass="card-field-value" wrapText="true"
                           minHeight="36" maxHeight="36" alignment="TOP_LEFT"
                           minWidth="0" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="2" HBox.hgrow="ALWAYS" minWidth="0" prefWidth="0">
                    <Label text="STIPEND" styleClass="card-field-label"/>
                    <Label fx:id="stipendValue" styleClass="card-field-value" wrapText="true"
                           minHeight="36" maxHeight="36" alignment="TOP_LEFT"
                           minWidth="0" maxWidth="Infinity"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Button fx:id="saveButton" styleClass="save-button" maxWidth="Infinity"
                    HBox.hgrow="ALWAYS"/>
            <Label fx:id="matchBadge" styleClass="match-badge"/>
            <ToggleButton fx:id="compareToggle" styleClass="compare-toggle"/>
        </HBox>
    </bottom>
</BorderPane>
