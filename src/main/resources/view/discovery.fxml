<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.CustomMenuItem?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.iskolar.controller.DiscoveryController">
    <top>
        <VBox spacing="10" styleClass="discovery-header">
            <VBox spacing="2">
                <Label text="Discover Scholarships" styleClass="view-title"/>
                <Label text="Scholarships you can apply for right now."
                       styleClass="view-subtitle" wrapText="true"/>
            </VBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search title or provider"
                           prefWidth="420" minWidth="180" maxWidth="600"/>
                <MenuButton fx:id="filterButton" text="Filters" styleClass="filter-menu-button">
                    <items>
                        <CustomMenuItem hideOnClick="false">
                            <content>
                                <VBox spacing="10" prefWidth="300" styleClass="filter-popover">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Filter scholarships"
                                               styleClass="filter-popover-title"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="resetButton" text="Reset"
                                                styleClass="link-button"/>
                                    </HBox>
                                    <ComboBox fx:id="programCombo" promptText="Any degree program"
                                              maxWidth="Infinity"/>
                                    <ComboBox fx:id="yearCombo" promptText="Any year"
                                              maxWidth="Infinity"/>
                                    <ComboBox fx:id="providerCombo" promptText="Any provider type"
                                              maxWidth="Infinity"/>
                                    <TextField fx:id="provinceField" promptText="Location (province)"
                                               maxWidth="Infinity"/>
                                    <CheckBox fx:id="eligibleOnlyCheck" text="Eligible only"/>
                                </VBox>
                            </content>
                        </CustomMenuItem>
                    </items>
                </MenuButton>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox fx:id="guestBanner" spacing="8" alignment="CENTER_LEFT"
                      styleClass="guest-hint">
                    <Label fx:id="bannerLabel" wrapText="true" styleClass="guest-hint-text"/>
                    <Button fx:id="bannerButton" text="Log in" styleClass="guest-hint-button"/>
                </HBox>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="resultLabel" styleClass="result-label"/>
                <Label text="·" styleClass="meta-dot"/>
                <Label fx:id="syncLabel" styleClass="sync-label" wrapText="true"/>
                <Button fx:id="syncButton" styleClass="icon-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Sort" styleClass="result-label"/>
                <ComboBox fx:id="sortCombo" prefWidth="180"/>
                <Button fx:id="compareButton" text="Compare (0)" disable="true"
                        styleClass="outline-button"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <StackPane>
            <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="card-scroll">
                <FlowPane fx:id="cardPane" hgap="16" vgap="16" styleClass="card-flow"/>
            </ScrollPane>
            <!-- Replaces the blank grid when no scholarship matches the filters. -->
            <VBox fx:id="emptyState" alignment="CENTER" spacing="10" maxWidth="420"
                  styleClass="empty-state" visible="false">
                <Label text="Nothing to show yet" styleClass="empty-state-title"/>
                <Label fx:id="emptyLabel" styleClass="empty-state-text" wrapText="true"
                       textAlignment="CENTER"/>
                <Button fx:id="emptyResetButton" text="Clear filters"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
