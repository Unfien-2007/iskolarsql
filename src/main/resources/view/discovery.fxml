<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.iskolar.controller.DiscoveryController">
    <top>
        <VBox spacing="10" styleClass="discovery-header">
            <Label text="Discover Scholarships" styleClass="view-title"/>
            <Label text="Browse active scholarships and filter by program, year level, provider, or location."
                   styleClass="view-subtitle" wrapText="true"/>
            <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT" styleClass="filter-bar">
                <TextField fx:id="searchField" promptText="Search title or provider" prefWidth="230"/>
                <ComboBox fx:id="programCombo" promptText="Any degree program" prefWidth="230"/>
                <ComboBox fx:id="yearCombo" promptText="Any year" prefWidth="110"/>
                <ComboBox fx:id="providerCombo" promptText="Any provider type" prefWidth="190"/>
                <TextField fx:id="provinceField" promptText="Location (province)" prefWidth="170"/>
                <CheckBox fx:id="eligibleOnlyCheck" text="Eligible only"/>
                <Button fx:id="resetButton" text="Reset"/>
            </FlowPane>
            <HBox fx:id="guestBanner" spacing="12" alignment="CENTER_LEFT" styleClass="guest-banner">
                <Label fx:id="bannerLabel" wrapText="true"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="bannerButton" text="Log in"/>
            </HBox>
            <HBox fx:id="syncBar" spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="syncLabel" styleClass="sync-label" wrapText="true"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="syncButton" text="Refresh catalog"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="resultLabel" styleClass="result-label"/>
                <Label fx:id="selectionLabel" styleClass="result-label" visible="false" managed="false"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Sort" styleClass="result-label"/>
                <ComboBox fx:id="sortCombo" prefWidth="180"/>
                <Button fx:id="compareButton" text="Compare (0)" disable="true"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <StackPane>
            <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="card-scroll">
                <FlowPane fx:id="cardPane" hgap="16" vgap="16" styleClass="card-flow"/>
            </ScrollPane>
            <!-- Replaces the blank grid when no scholarship matches the filters. -->
            <VBox fx:id="emptyState" alignment="CENTER" spacing="10" maxWidth="420"
                  styleClass="empty-state" visible="false">
                <Label text="Nothing to show yet" styleClass="empty-state-title"/>
                <Label fx:id="emptyLabel" styleClass="empty-state-text" wrapText="true"
                       textAlignment="CENTER"/>
                <Button fx:id="emptyResetButton" text="Clear filters"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
