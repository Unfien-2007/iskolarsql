<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<!-- One Kanban card; data + callbacks injected by TrackerCardController.
     The column header already names the stage, so the card carries no status
     caption. Every row is a FlowPane: at ~168px the deadline pill, match badge
     and remove action stay on one line, and they wrap instead of forcing the
     card wider than its column when the board is compressed. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.iskolar.controller.TrackerCardController"
      styleClass="tracker-card" prefWidth="232" spacing="8">
    <Label fx:id="titleLabel" styleClass="card-title" wrapText="true" maxWidth="Infinity"
           maxHeight="50"/>
    <Label fx:id="providerLabel" styleClass="card-provider" wrapText="true" maxWidth="Infinity"/>
    <FlowPane alignment="CENTER_LEFT" hgap="4" vgap="4">
        <Label fx:id="deadlinePill" styleClass="pill"/>
        <Label fx:id="matchBadge" styleClass="match-badge"/>
        <Button fx:id="removeButton" styleClass="icon-button"/>
    </FlowPane>
    <FlowPane fx:id="actionsBox" hgap="6" vgap="6"/>
</VBox>
